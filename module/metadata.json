{
  "name": "netgraph_module",
  "version": "0.0.1",
  "description": "Live observer of every network connection the Logos process tree holds, grouped by service and network. Local only, off until turned on.",
  "author": "corpetty",
  "type": "core",
  "category": "monitoring",
  "main": "netgraph_module_plugin",
  "interface": "universal",
  "codegen": {
    "impl_header": "netgraph_impl.h",
    "impl_class": "NetgraphImpl"
  },
  "dependencies": [],
  "interface_dependencies": [
    { "name": "connection_source", "file": "interfaces/connection_source.h", "impl_class": "IConnectionSource" },
    { "name": "core_service", "file": "interfaces/core_service.h", "impl_class": "ICoreService" }
  ],

  "nix": {
    "external_libraries": [],
    "packages": {
      "build": [],
      "runtime": ["nlohmann_json"]
    },
    "cmake": {
      "find_packages": [],
      "extra_sources": []
    }
  }
}
